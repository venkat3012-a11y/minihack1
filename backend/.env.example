# EvalAI Maths Evaluation Backend Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Server config
HOST=127.0.0.1
PORT=8000
SECRET_KEY=evalai-maths-super-secret-key-change-in-production-2026
TEACHER_INVITE_CODE=EVALAI-TEACHER-2026

# Database & Storage
DATABASE_PATH=evalai.db
STORAGE_DIR=storage

# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
# Leave empty to use deterministic SymPy local verification engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
