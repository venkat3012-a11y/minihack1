# EvalAI Maths Evaluation Backend Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Server config
HOST=127.0.0.1
PORT=8000
SECRET_KEY=evalai-maths-super-secret-key-change-in-production-2026

# Database
DATABASE_PATH=evalai.db
STORAGE_DIR=storage

# Google Gemini API (REQUIRED for AI evaluation)
# Get your key from: https://aistudio.google.com/app/apikey
# Leave empty to use local SymPy-only fallback engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
